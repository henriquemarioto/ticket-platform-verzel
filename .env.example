# Ambiente da aplicação (development | staging | production). O seed automático só roda em ambientes diferentes de production.
APP_ENV="development"

# Database connection for Prisma
# DATABASE_URL is used by the application (usually points to a connection pooler like PgBouncer in production)
# In local development, we use the direct connection for both.
DATABASE_URL="postgresql://postgres:password@postgres:5432/ticket_platform?schema=public"

# DIRECT_URL is used for migrations (direct connection to the database)
DIRECT_URL="postgresql://postgres:password@postgres:5432/ticket_platform?schema=public"

# Authentication secret for JWT / NextAuth / Jose (run `openssl rand -base64 32` to generate a secure secret)
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Secret used to generate HMAC signatures for QR codes (run `openssl rand -base64 32`)
QR_HMAC_SECRET="your-super-secret-hmac-key-change-in-production"

# The Movie Database (TMDb) API Key (Used as a fallback for the catalog)
TMDB_API_KEY="your_tmdb_api_key_here"

# Ticketmaster API Key (Used for event catalog integration)
TICKETMASTER_API_KEY="your_ticketmaster_api_key_here"
